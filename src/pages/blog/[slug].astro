---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Contents from '../../components/Contents.astro';
import Page from '../../layouts/Page.astro';
import HeadingList from '../../components/HeadingList.astro';
import { publishedPosts } from '../../posts';

export async function getStaticPaths() {
  return (await publishedPosts()).map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, publishedAt, updatedAt } = post.data;
const minutes = Math.max(1, Math.ceil((post.body ?? '').trim().split(/\s+/).length / 220));
---
<Page {title} {description} active="/writing">
  <article>
    <h1>{title}</h1>
    <p class="metadata">Published <time datetime={publishedAt}>{publishedAt}</time> · {minutes} min read
      {updatedAt && <> · Updated <time datetime={updatedAt}>{updatedAt}</time></>}
    </p>
    {headings.length > 0 && <Contents><HeadingList {headings} /></Contents>}
    <Content />
  </article>
</Page>
